+  buildToolbar(); buildLibrary(); layoutChrome(); panelKey = ''; render();
+}
+function toggleTheme(){ prefs.theme = isDark() ? 'light' : 'dark'; savePrefs(); applyTheme(); }
+matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { if (!prefs.theme) applyTheme(); });
+$('#help').addEventListener('click', e => { if (e.target.id === 'help') $('#help').classList.remove('open'); });
+$('#boardName').addEventListener('input', e => { board.name = e.target.value; save(); });
+$('#boardName').addEventListener('keydown', e => { e.stopPropagation(); if (e.key === 'Enter') e.target.blur(); });
+$('#bottomleft').addEventListener('click', e => {
+  const a = e.target.closest('[data-act]')?.dataset.act;
+  if (a === 'undo') undo(); if (a === 'redo') redo();
