+  if (e.shiftKey) return;
+  const map = {v: 'select', h: 'hand', p: 'draw', e: 'eraser', l: 'link', a: 'arrow', t: 'text', n: 'note', r: 'rect', o: 'ellipse', d: 'diamond', c: 'cloud', f: 'zone'};
